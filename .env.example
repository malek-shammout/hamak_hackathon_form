# Runtime: use Neon's pooled connection string (hostname includes -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require

# Schema operations only: use Neon's direct (non-pooled) connection string.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Set a long unique password for the organizer dashboard.
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-a-random-secret
