# ---- Supabase (Project → Connect button at the top of the dashboard) ----
# Runtime: "Transaction pooler" string (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Schema tools only (drizzle-kit): "Session pooler" string (port 5432). Not needed on Vercel.
DATABASE_URL_UNPOOLED=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional, strictest TLS: paste Supabase's CA certificate (Database settings → SSL → Download certificate).
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Organizer dashboard password (long and unique).
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-a-random-secret
